# ============================================================
# .env.example — 複製為 .env 並填入真實值，勿 commit .env
# ============================================================

# ── TDX 交通資料平台 ──────────────────────────────────────────
# 申請網址：https://tdx.transportdata.tw/register
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret

# ── 中央氣象署 Open Data ──────────────────────────────────────
# 申請網址：https://opendata.cwa.gov.tw/user/authkey
# 免費，申請後立即可用
CWB_API_KEY=your-cwa-api-key

# ── 系統設定 ──────────────────────────────────────────────────
# SQLite 資料庫路徑
DB_PATH=taiwan_osm.db

# 自動同步間隔（秒）。設 0 停用自動同步。
# 建議：300（5分鐘）= TDX 車速更新頻率
AUTO_SYNC_INTERVAL=300

# 管理員 Token（保護寫入端點，localhost 免驗證）
ADMIN_TOKEN=your-admin-token

# 全路網載入記憶體（路由零 DB 查詢；啟動 ~100s、RAM ~6GB，適合大記憶體機器）
# 注意：長程路線在此模式下容易撞上 A* 的 200 萬步上限而失敗（搜尋空間大 5 倍）。
PRELOAD_ALL_ROADS=0

# 路口收縮圖（把兩個路口之間的形狀點鏈收成一條 link，A* 改跑在 link 圖上）
# 實測：節點壓縮 22.3 倍、邊壓縮 17.3 倍，50 條路線總耗時 185s → 14s。
# 必須搭配 PRELOAD_ALL_ROADS=0；設成 1 時會自動停用切割並印出警告，
# 因為全路網含大量 service 道路、路口密度太高，收縮只有 3.7 倍不划算。
# 已知取捨：切割模式不使用端點局部圖，部分路線會長 2~8%（見 osm_partition.py）。
PARTITION_MODE=0

# 事件沿路網往上游傳播（教授計畫書的增量 PageRank 推送，見 osm_propagation.py）
# 原方框法照常保留，再加上往上游、逐段衰減的影響；只作用於事故、施工、手動事件。
# 必須搭配 PARTITION_MODE=1（用路口收縮圖當子圖），且需要 numpy、scipy。
EVENT_PROPAGATION=0

# 事故衝擊參數用真實資料校準值（164 件國道事故實測，見 gcn/results/impact_calibration.json）
# 0=原參數（severity 0.80 / radius 0.8km），1=校準值（0.71 / 1.1km）
IMPACT_CALIBRATED=0
