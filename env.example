# ============================================================
# .env.example — 複製為 .env 並填入真實值，勿 commit .env
# ============================================================

# ── TDX 交通資料平台 ──────────────────────────────────────────
# 申請網址：https://tdx.transportdata.tw/register
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret

# ── 中央氣象署 Open Data ──────────────────────────────────────
# 申請網址：https://opendata.cwa.gov.tw/user/authkey
# 免費，申請後立即可用
CWB_API_KEY=your-cwa-api-key

# ── 系統設定 ──────────────────────────────────────────────────
# SQLite 資料庫路徑
DB_PATH=taiwan_osm.db

# 自動同步間隔（秒）。設 0 停用自動同步。
# 建議：300（5分鐘）= TDX 車速更新頻率
AUTO_SYNC_INTERVAL=300

# 管理員 Token（保護寫入端點，localhost 免驗證）
ADMIN_TOKEN=your-admin-token

# 全路網載入記憶體（路由零 DB 查詢；啟動 ~100s、RAM ~6GB，適合大記憶體機器）
PRELOAD_ALL_ROADS=0
